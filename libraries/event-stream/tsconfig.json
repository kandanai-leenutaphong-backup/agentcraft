{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "frontend",
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["frontend/**/*.ts"]
}