{
  "name": "@agentcraft/resource-explorer",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./inventory.css": "./dist/inventory.css",
    "./explorer.css": "./dist/explorer.css",
    "./assets/*": "./docs/skills/assets/*"
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES", "docs/skills/resource-explorer.md", "docs/skills/assets"],
  "sideEffects": ["./dist/index.js", "**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@agentcraft/source-code": "file:../source-code",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@agentcraft/source-code": "^0.1.0",
    "react": "^19.0.0",
    "lucide-react": "^1.42.0"
  }
}