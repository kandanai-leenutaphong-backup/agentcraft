{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "frontend",
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["react"]
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}