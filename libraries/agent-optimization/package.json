{
  "name": "@agentcraft/agent-optimization",
  "version": "0.1.0",
  "type": "module",
  "description": "Frozen-cohort optimization workspace and persisted run replay",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/agent-optimization.js" },
    "./types": "./dist/types.d.ts",
    "./styles": { "types": "./frontend/style-export.d.ts", "default": "./dist/optimization.css" }
  },
  "files": ["dist", "frontend", "README.md", "CONTRACT.md", "LICENSE", "PROVENANCE.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/test_continue_campaign.mjs",
    "test:replay": "node tests/replay-smoke.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "lucide-react": ">=0.460.0 <2",
    "copilot-terminal": "^0.2.0",
    "@agentcraft/source-code": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.460.0",
    "playwright": "^1.63.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.0"
  }
}