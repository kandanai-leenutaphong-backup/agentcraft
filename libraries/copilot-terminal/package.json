{
  "name": "copilot-terminal",
  "version": "0.2.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles": { "types": "./dist/copilot-terminal.css.d.ts", "default": "./dist/copilot-terminal.css" }
  },
  "files": ["dist", "src", "tsconfig.json", "tsconfig.build.json", "README.md", "GUIDE.md", "CONTRACT.md", "GOTCHAS.md", "PROVENANCE.md", "LICENSE", "references", "examples", "tests"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/copilot-terminal.css dist/copilot-terminal.css && node --input-type=module -e \"import {writeFileSync} from 'node:fs'; writeFileSync('dist/copilot-terminal.css.d.ts', 'export {};\\n');\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "build:example": "vite build --config examples/vite.config.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.42.0"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^22.19.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^7.3.0",
    "typescript": "~6.0.2"
  }
}