FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.9.30 /uv /usr/local/bin/uv
WORKDIR /workspace
COPY libraries libraries
COPY template_apps/shared template_apps/shared
COPY template_apps/investigation_app/pyproject.toml template_apps/investigation_app/uv.lock template_apps/investigation_app/
WORKDIR /workspace/template_apps/investigation_app
RUN uv export --frozen --no-dev --no-hashes --format requirements-txt --output-file /tmp/requirements.txt \
    && uv pip install --system --no-cache --no-sources -r /tmp/requirements.txt
COPY template_apps/investigation_app/app app
COPY deploy /workspace/deploy
COPY package /workspace/package
RUN useradd --uid 10001 --create-home app \
    && mkdir -p /state/agents && chown -R app:app /state
ENV PYTHONDONTWRITEBYTECODE=1 PYTHON_DOTENV_DISABLED=1 PYTHONPATH=/workspace/template_apps/investigation_app
EXPOSE 8080
USER app
CMD ["python", "-m", "uvicorn", "app.cybereye.backend.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--no-server-header"]