{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {"@components/*": ["./*"]},
    "types": ["vite/client"]
  },
  "include": ["agent_optimization/frontend/**/*.ts", "agent_optimization/frontend/**/*.tsx"]
}