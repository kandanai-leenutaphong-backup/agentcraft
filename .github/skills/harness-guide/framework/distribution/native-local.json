    "    refusals = {action: service.handle(action, headers, started[0] | {'key': started[1]['key']})[0]",
    "        for action in ('output', 'input', 'resize', 'stop', 'source')}",
    "    assert set(refusals.values()) == {404}",
    "    assert service.handle('input', headers | {'origin': 'https://example.invalid'}, started[0] | {'data': 'denied'})[0] == 403",
    "    assert service.handle('input', headers, started[0] | {'data': 'owned-first\\r'})[0] == 200",
    "    first_text, first_output = read_until(started[0], 'Fixture received: owned-first')",
    "    status, second_output = service.handle('output', headers, started[1])",
    "    assert status == 200 and 'owned-first' not in second_output['output']",
    "    assert service.handle('resize', headers, started[0] | {'columns': 87, 'rows': 24})[0] == 200",
    "    read_until(started[0], '\\x1b[24;1H')",
    "    assert service.handle('input', headers, started[0] | {'data': '\\x03'})[0] == 200",
    "    read_until(started[0], 'Fixture interrupt received')",
    "    status, source = service.handle('source', headers, started[0] | {'source': {'id': 'synthetic'}})",
    "    assert status == 200",
    "    staged = Path(started[0]['workspace']) / source['path']",
    "    assert staged.read_bytes() == b'native source readback\\n' and staged.stat().st_mode & 0o777 == 0o400",
    "    assert service.handle('stop', headers, started[0])[0] == 200",
    "    revoked_status = service.handle('output', headers, started[0])[0]",
    "    assert revoked_status == 404 and absent(processes[0]) and group_absent(processes[0])",
    "    assert service.handle('input', headers, started[1] | {'data': 'survived-peer-stop\\r'})[0] == 200",
    "    read_until(started[1], 'Fixture received: survived-peer-stop')",
    "    result.update({'service_pids': processes, 'service_pgids': processes, 'service_sids': processes,",
    "        'cross_session_refusals': refusals, 'cross_origin_status': 403, 'source_readback_bytes': source['bytes'],",
    "        'source_mode': '0400', 'resize': {'columns': 87, 'rows': 24}, 'stop_revoked_status': revoked_status,",
    "        'peer_survived_stop': True, 'workspaces_retained': [payload['workspace'] for payload in started]})",
    "finally:",
    "    service.close()",
    "assert all(absent(process_id) and group_absent(process_id) for process_id in processes)",
    "",
    "workspace = root / 'lifetime'",
    "workspace.mkdir()",
    "child_code = 'import signal; signal.pause()'",
    "parent_code = 'import os,subprocess,sys; child=subprocess.Popen([sys.executable,\"-I\",\"-B\",\"-c\",sys.argv[1]]); print(\"DESCENDANT\",child.pid,flush=True); input()'",
    "terminal = PtySession([sys.executable, '-I', '-B', '-u', '-c', parent_code, child_code], workspace,",
    "    {'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8', 'PYTHONDONTWRITEBYTECODE': '1'}, lifetime_seconds=0.5)",
    "descendant_id = None",
    "pidfd = None",
    "try:",
    "    deadline = time.monotonic() + 5",
    "    output = terminal.output()",
    "    while 'DESCENDANT ' not in output['output'] and time.monotonic() < deadline:",
    "        terminal.output(output['cursor'], wait=0.2)",
    "        output = terminal.output()",
    "    descendant_id = int(output['output'].split('DESCENDANT ')[1].split()[0])",
    "    pidfd = os.pidfd_open(descendant_id)",
    "    assert os.getpgid(descendant_id) == terminal.process.pid == os.getsid(descendant_id)",
    "    while output['running'] and time.monotonic() < deadline:",
    "        terminal.output(output['cursor'], wait=0.2)",
    "        output = terminal.output()",
    "    assert not output['running'] and 'Session time limit reached.' in output['output']",
    "    assert output['exit_code'] == terminal.process.poll() == -signal.SIGTERM",
    "    assert select.select([pidfd], [], [], 3)[0]",
    "    waited_id, wait_status = os.waitpid(descendant_id, 0)",
    "    assert waited_id == descendant_id and os.WIFSIGNALED(wait_status) and os.WTERMSIG(wait_status) == signal.SIGTERM",
    "    result['lifetime'] = {'seconds': 0.5, 'pid': terminal.process.pid, 'descendant_pid': descendant_id,",
    "        'process_group': terminal.process.pid, 'exit_code': output['exit_code'], 'descendant_exit_code': -os.WTERMSIG(wait_status),",
    "        'output_running': output['running'], 'limit_message_observed': True, 'descendant_reaped_by_owned_probe': True}",
    "finally:",
    "    terminal.close()",
    "    if descendant_id is not None and not absent(descendant_id):",
    "        if pidfd is not None:",
    "            signal.pidfd_send_signal(pidfd, signal.SIGKILL)",
    "        os.waitpid(descendant_id, 0)",
    "    if pidfd is not None:",
    "        os.close(pidfd)",
    "assert absent(terminal.process.pid) and absent(descendant_id) and group_absent(terminal.process.pid)",
    "assert os.getpgrp() == original_group and os.getsid(0) == original_session",
    "result.update({'owned_children_remaining': sorted(children()), 'original_process_group_preserved': True,",
    "    'fixture_workspaces_retained': True, 'passed': True})",
    "assert result['owned_children_remaining'] == []",
    "print(json.dumps(result, indent=2))"
  ]
}