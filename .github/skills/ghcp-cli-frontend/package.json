  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^22.19.0",
    "oxlint": "^1.79.0",
    "react-dom": "^19.2.8",
    "vite": "^7.3.0",
    "typescript": "~6.0.2"
  }
}