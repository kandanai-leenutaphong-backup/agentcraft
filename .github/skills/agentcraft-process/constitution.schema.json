{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCraft constitution v2 (v1 compatible)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "status", "decision_source", "objective", "primary_metric", "metrics", "dataset", "deployment", "authority", "collaboration", "reporting", "notebook"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "project_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["exploring", "ready"]},
    "decision_source": {"$ref": "#/$defs/text"},
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["beneficiary", "outcome", "decision_owner"],
      "properties": {"beneficiary": {"$ref": "#/$defs/text"}, "outcome": {"$ref": "#/$defs/text"}, "decision_owner": {"$ref": "#/$defs/text"}}
    },
    "primary_metric": {"$ref": "#/$defs/id"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "data_understanding": {
      "type": "object", "additionalProperties": false,
      "required": ["sources", "questions", "permitted_experiments", "outputs", "verification", "transition"],
      "properties": {
        "sources": {"$ref": "#/$defs/list"}, "questions": {"$ref": "#/$defs/list"},
        "permitted_experiments": {"$ref": "#/$defs/list"}, "outputs": {"$ref": "#/$defs/list"},
        "verification": {"$ref": "#/$defs/text"}, "transition": {"$ref": "#/$defs/text"}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "revision", "scenario_policy", "held_out_policy"],
      "properties": {"manifest": {"const": "dataset/manifest.json"}, "revision": {"$ref": "#/$defs/optionalText"}, "scenario_policy": {"$ref": "#/$defs/text"}, "held_out_policy": {"$ref": "#/$defs/text"}}
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "identity", "live_test", "restore"],
      "properties": {"target": {"$ref": "#/$defs/text"}, "identity": {"$ref": "#/$defs/text"}, "live_test": {"$ref": "#/$defs/text"}, "restore": {"$ref": "#/$defs/text"}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "scope", "permitted_operations", "protected_resources", "operational_actions", "max_iterations", "max_model_requests", "max_spend", "currency", "expires_at", "stop_conditions", "cleanup_owner"],
      "properties": {
        "source": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"},
        "permitted_operations": {"$ref": "#/$defs/list"},
        "protected_resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "operational_actions": {"$ref": "#/$defs/text"},
        "limit_policy": {"enum": ["bounded", "user-unbounded"]},
        "max_iterations": {"type": ["integer", "null"], "minimum": 1},
        "max_model_requests": {"type": ["integer", "null"], "minimum": 0},
        "max_spend": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "stop_conditions": {"$ref": "#/$defs/list"}, "cleanup_owner": {"$ref": "#/$defs/text"}
      }
    },
    "collaboration": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewers", "checkpoints"],
      "properties": {"reviewers": {"$ref": "#/$defs/list"}, "checkpoints": {"$ref": "#/$defs/text"}}
    },
    "reporting": {
      "type": "object", "additionalProperties": false,
      "required": ["results", "project_report", "dashboard"],
      "properties": {"results": {"const": "results/<run-id>/"}, "project_report": {"const": "reports/latest.html"}, "dashboard": {"$ref": "#/$defs/text"}}
    },
    "notebook": {"const": "notebook/lessons.md"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"status": {"const": "ready"}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["data_understanding"], "properties": {"authority": {"required": ["limit_policy"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {
        "metrics": {"items": {"properties": {
          "evaluator": {"$ref": "#/$defs/text"}, "rubric": {"$ref": "#/$defs/text"},
          "target": {"properties": {"value": {"type": "number"}}}
        }}},
        "dataset": {"properties": {"revision": {"$ref": "#/$defs/text"}}}
      }}
    },
    {
      "if": {"properties": {"authority": {
        "required": ["limit_policy"], "properties": {"limit_policy": {"const": "user-unbounded"}}
      }}},
      "then": {"properties": {"schema_version": {"const": 2}}},
      "else": {"properties": {"authority": {"properties": {
        "max_iterations": {"type": "integer"}, "max_model_requests": {"type": "integer"},
        "max_spend": {"type": "number"}, "currency": {"type": "string"}, "expires_at": {"type": "string"}
      }}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?!\\s*(?:REQUIRED|TODO|TBD)\\s*$)[\\s\\S]*\\S[\\s\\S]*$"},
    "optionalText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "list": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "measure", "unit", "aggregation", "evaluator", "sample_policy", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["objective", "judgment"]},
        "measure": {"$ref": "#/$defs/text"}, "unit": {"$ref": "#/$defs/text"},
        "aggregation": {"$ref": "#/$defs/text"}, "evaluator": {"$ref": "#/$defs/optionalText"},
        "sample_policy": {"$ref": "#/$defs/text"}, "rubric": {"$ref": "#/$defs/optionalText"},
        "target": {
          "type": "object", "additionalProperties": false, "required": ["operator", "value"],
          "properties": {"operator": {"enum": [">=", "<=", "=="]}, "value": {"type": ["number", "null"]}}
        }
      },
      "if": {"properties": {"kind": {"const": "judgment"}}},
      "then": {"required": ["rubric"]}
    }
  }
}