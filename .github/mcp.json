{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "azure-data-connectors": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/skills/azure-data-connectors/scripts/serve_mcp.py"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv",
        "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
        "UV_PYTHON_DOWNLOADS": "never",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "azure-llm-connectors": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/skills/azure-llm-connectors/scripts/serve_mcp.py"],
      "cwd": "${PLUGIN_DATA}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    },
    "resource-explorer": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/skills/resource-explorer/scripts/serve_mcp.py"],
      "cwd": "${PLUGIN_DATA}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    },
    "managed-identity-model-clients": {
