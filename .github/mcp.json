      "cwd": "${PLUGIN_DATA}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    },
    "portable-app-composition": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/skills/portable-app-composition/scripts/serve_mcp.py"],
      "cwd": "${PLUGIN_DATA}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    },
    "recoverable-jobs": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/skills/recoverable-jobs/scripts/serve_mcp.py"],
      "cwd": "${PLUGIN_DATA}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    },
    "azure-access-management": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/skills/azure-access-management/scripts/serve_mcp.py"],
      "cwd": "${PLUGIN_DATA}",
